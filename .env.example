# Copy to .env and fill in. Never commit .env.
MATTERPORT_API_KEY=
MATTERPORT_API_TOKEN=
VEXCEL_API_KEY=
COSTAR_KIT_URL=
COSTAR_ZIP_PASSWORD=
ANTHROPIC_API_KEY=
LANGSMITH_API_KEY=
# World API
WORLD_API_TOKEN=
WORLD_ADMIN_TOKEN=
WORLD_DATA_DIR=./data
CAPTION_MODEL=claude-haiku-5-5
CAPTION_FALLBACK_MODELS=claude-sonnet-5-5
CAPTION_DETAIL=deep
CAPTION_EFFORT=low
# local = small embedding model on this machine (no key); none = keyword search only
EMBED_PROVIDER=local
EMBED_MODEL=BAAI/bge-small-en-v1.5
MAX_PANOS_PER_SPACE=20
CORS_ORIGINS=*
