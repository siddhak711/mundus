[Unit]
Description=Atlas site (server.py: pages, site-model API, Ask Atlas bridge to the agent server)
After=network-online.target mundus-world.service mundus-harness.service

[Service]
User=@USER@
WorkingDirectory=@ROOT@
EnvironmentFile=@ROOT@/.env
ExecStart=@ROOT@/.venv/bin/python server.py 5190
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
