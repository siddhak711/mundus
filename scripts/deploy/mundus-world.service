[Unit]
Description=Census World API (REST + MCP)
After=network-online.target

[Service]
User=@USER@
WorkingDirectory=@ROOT@/backend
EnvironmentFile=@ROOT@/.env
ExecStart=@ROOT@/backend/.venv/bin/mundus serve --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
