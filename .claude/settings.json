{
  "extraKnownMarketplaces": {
    "cursor-plugins": {
      "source": {
        "source": "github",
        "repo": "cursor/plugins"
      }
    }
  },
  "enabledPlugins": {
    "pstack@cursor-plugins": true
  },
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "Bash(scripts/verify.sh)",
      "Bash(scripts/check-work.sh *)",
      "Bash(scripts/check-work.sh)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git branch *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git push *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit-verify.sh\"",
            "timeout": 120,
            "statusMessage": "Running scripts/verify.sh"
          }
        ]
      }
    ]
  }
}
