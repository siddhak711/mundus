{
  "extraKnownMarketplaces": {
    "cursor-plugins": {
      "source": {
        "source": "github",
        "repo": "cursor/plugins"
      }
    }
  },
  "enabledPlugins": {
    "pstack@cursor-plugins": true
  },
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "Bash(scripts/verify.sh)",
      "Bash(scripts/check-work.sh *)",
      "Bash(scripts/check-work.sh)",
      "Bash(scripts/check-title.sh *)",
      "Bash(scripts/check-pr-scope.sh *)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git branch *)",
      "Bash(git fetch *)",
      "Bash(git merge *)",
      "Bash(git pull *)",
      "Bash(git push *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push origin main*)",
      "Bash(git reset --hard *)",
      "Bash(git commit --no-verify *)",
      "Bash(git commit -n *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git -C \"$CLAUDE_PROJECT_DIR\" config core.hooksPath .githooks",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
