WORLD_REST_URL=http://127.0.0.1:8000
WORLD_MCP_URL=http://127.0.0.1:8000/mcp/
WORLD_API_TOKEN=
ORCH_MODEL=anthropic:claude-sonnet-5-5
WORKER_MODEL=anthropic:claude-haiku-5-5
